# ============ 应用基础配置 ============

# 应用名称
APP_NAME="媒体AI Agent工作流系统"
# 应用版本
APP_VERSION="1.0.0"
# 调试模式（生产环境设为false）
DEBUG=false

# ============ 数据库配置 ============

# PostgreSQL连接地址
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/media_agent"

# ============ Redis配置（可选）============

# Redis连接地址，用于缓存
# 格式: redis://用户名:密码@主机:端口/数据库编号
REDIS_URL="redis://localhost:6379/0"

# ============ AI大模型API配置 ============

# OpenAI API密钥
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# OpenAI API地址（默认官方地址）
OPENAI_BASE_URL="https://api.openai.com/v1"
# OpenAI模型名称
OPENAI_MODEL="gpt-4o"

# Anthropic API密钥
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Anthropic模型名称
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# ============ 认证配置 ============

# JWT密钥（生产环境务必更换为复杂随机字符串）
SECRET_KEY="your-secret-key-change-in-production"
# JWT算法
ALGORITHM="HS256"
# Token过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============ CORS跨域配置 ============

# 允许的跨域来源（逗号分隔，无空格）
# 示例: "http://localhost:3000,http://example.com"
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# ============ 文件存储配置 ============

# 文件上传目录
UPLOAD_DIR="./uploads"
# 最大文件大小（字节），默认100MB
MAX_FILE_SIZE=104857600

# ============ 平台API配置 ============

# 抖音开放平台
DOUYIN_CLIENT_KEY="your_douyin_client_key"
DOUYIN_CLIENT_SECRET="your_douyin_client_secret"

# 快手开放平台
KUAI_SHOU_CLIENT_KEY="your_kuaishou_client_key"
KUAI_SHOU_CLIENT_SECRET="your_kuaishou_client_secret"

# 小红书开放平台
XIAO_HONG_SHU_CLIENT_KEY="your_xiaohongshu_client_key"
XIAO_HONG_SHU_CLIENT_SECRET="your_xiaohongshu_client_secret"

# 微信公众号
WECHAT_APP_ID="your_wechat_app_id"
WECHAT_APP_SECRET="your_wechat_app_secret"

# 微博开放平台
WEIBO_APP_KEY="your_weibo_app_key"
WEIBO_APP_SECRET="your_weibo_app_secret"

# ============ Agent配置 ============

# Agent最大迭代次数
AGENT_MAX_ITERATIONS=10
# Agent超时时间（秒）
AGENT_TIMEOUT=300
